PORT=5000
NODE_ENV=production

# MongoDB Atlas free tier (M0) connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/jsn_referral?retryWrites=true&w=majority

# Long random strings - generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_this_with_a_long_random_string
JWT_REFRESH_SECRET=replace_this_with_another_long_random_string

# Access token short-lived, refresh token long-lived
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Comma separated list of allowed frontend origins
CLIENT_URL=http://localhost:5173,https://jsn-referral.vercel.app

# Public URL of THIS backend once deployed on Render, used for self-ping keep-alive
SERVER_URL=https://jsn-referral-api.onrender.com

# Admin bootstrap - used once by the seed script to create the first admin account
ADMIN_NAME=Muhammad Jawad
ADMIN_EMAIL=admin@jsncreative.studio
ADMIN_PASSWORD=change_this_immediately

# Default commission rate applied to new referral programs (percentage)
DEFAULT_COMMISSION_PERCENT=10
